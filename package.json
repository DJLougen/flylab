{
  "name": "flylab",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run licenses:check && vinext build && npm run licenses:check-build",
    "start": "vinext start",
    "assets:brain": "node scripts/build-banc-morphology.mjs",
    "demo:narration-plan": "node scripts/build-demo-video.mjs --print-plan",
    "demo:preflight": "node scripts/build-demo-video.mjs --check",
    "demo:video": "node scripts/build-demo-video.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:check-build": "node scripts/generate-third-party-notices.mjs --check-build",
    "test": "tsc -p tests/tsconfig.json && node --test tests/.compiled/tests/*.test.js",
    "verify:webmcp": "node scripts/verify-live-webmcp.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
